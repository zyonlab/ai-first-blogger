---
type Props = {
  video: {
    data: {
      title: string;
      description: string;
      slug: string;
      pubDate: Date;
      topics: string[];
    };
  };
};

const { video } = Astro.props;
---

<article class="card video-card">
  <div class="video-thumb" aria-hidden="true">▶</div>
  <h3><a href={`/videos/${video.data.slug}/`}>{video.data.title}</a></h3>
  <p>{video.data.description}</p>
  <div class="tags">
    {video.data.topics.map((topic) => <span>{topic}</span>)}
  </div>
</article>
