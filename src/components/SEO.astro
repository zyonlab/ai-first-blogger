---
import { site } from '@data/site';
import { absoluteUrl } from '@lib/seo';

type Props = {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  tags?: string[];
};

const {
  title,
  description,
  canonical = Astro.url.pathname,
  image = site.defaultImage,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  tags = [],
} = Astro.props;

const pageTitle = title === site.name ? site.title : `${title} · ${site.name}`;
const canonicalUrl = absoluteUrl(canonical);
const imageUrl = absoluteUrl(image);
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={site.author.name} />
<meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1'} />
<link rel="canonical" href={canonicalUrl} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="zh_CN" />
{type === 'article' && publishedTime && <meta property="article:published_time" content={new Date(publishedTime).toISOString()} />}
{type === 'article' && modifiedTime && <meta property="article:modified_time" content={new Date(modifiedTime).toISOString()} />}
{type === 'article' && <meta property="article:author" content={site.author.name} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
