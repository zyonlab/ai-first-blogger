---
type Props = {
  project: {
    data: {
      title: string;
      description: string;
      slug: string;
      status: string;
      techStack: string[];
      highlights: string[];
    };
  };
};

const { project } = Astro.props;
---

<article class="card project-card">
  <div class="eyebrow">{project.data.status}</div>
  <h3><a href={`/projects/${project.data.slug}/`}>{project.data.title}</a></h3>
  <p>{project.data.description}</p>
  <div class="tags">
    {project.data.techStack.slice(0, 5).map((tech) => <span>{tech}</span>)}
  </div>
</article>
