---
import PageLayout from '@layouts/PageLayout.astro';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '@lib/schema';
import type { DiscoveryPage } from '@lib/discovery';
import DiscoveryCard from './DiscoveryCard.astro';
import DiscoveryPagination from './DiscoveryPagination.astro';

type Props = {
  title: string;
  description: string;
  eyebrow: string;
  canonical: string;
  baseUrl: string;
  pageData: DiscoveryPage;
};

const { title, description, eyebrow, canonical, baseUrl, pageData } = Astro.props as Props;
const displayTitle = pageData.page === 1 ? title : `${title} · 第 ${pageData.page} 页`;
const jsonLd = [
  collectionPageSchema(displayTitle, description, canonical),
  itemListSchema(displayTitle, pageData.items.map((item) => ({
    name: item.title,
    description: item.description,
    url: item.url,
  }))),
  breadcrumbSchema([
    { name: '首页', url: '/' },
    { name: displayTitle, url: canonical },
  ]),
];
---

<PageLayout title={displayTitle} description={description} eyebrow={eyebrow} canonical={canonical} jsonLd={jsonLd}>
  <section class="discovery-listing" aria-label={title}>
    <p class="result-count">共 {pageData.total} 项</p>
    <div class="discovery-grid">
      {pageData.items.map((item) => <DiscoveryCard item={item} />)}
    </div>
    <DiscoveryPagination page={pageData.page} pageCount={pageData.pageCount} baseUrl={baseUrl} />
  </section>
</PageLayout>

<style>
  .discovery-listing { margin-top: 8px; }
  .result-count { margin: 0 0 18px; color: var(--muted); font-size: .86rem; }
  .discovery-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 720px) { .discovery-grid { grid-template-columns: 1fr; } }
</style>
