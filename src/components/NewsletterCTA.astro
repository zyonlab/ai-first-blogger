---
import { site } from '@data/site';
---

<section class="cta-panel">
  <p>如果你在做相近的项目，可以带着具体问题和背景来聊。</p>
  <div class="actions">
    <a class="button primary" href="/work-with-me/">咨询合作</a>
    {site.author.email && <a class="button" href={`mailto:${site.author.email}?subject=${site.name}`}>发邮件</a>}
  </div>
</section>
