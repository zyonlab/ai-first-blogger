---
type Props = {
  page: number;
  pageCount: number;
  baseUrl: string;
};

const { page, pageCount, baseUrl } = Astro.props as Props;
const hrefFor = (target: number) => target === 1 ? baseUrl : `${baseUrl}page/${target}/`;
---

{pageCount > 1 && (
  <nav class="pagination" aria-label="分页">
    {page > 1 ? <a rel="prev" href={hrefFor(page - 1)}>← 上一页</a> : <span aria-hidden="true"></span>}
    <span>第 {page} / {pageCount} 页</span>
    {page < pageCount ? <a rel="next" href={hrefFor(page + 1)}>下一页 →</a> : <span aria-hidden="true"></span>}
  </nav>
)}

<style>
  .pagination { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; margin: 40px 0 72px; color: var(--muted); font-size: .88rem; }
  .pagination a { width: fit-content; padding: 8px 13px; border: 1px solid var(--line); border-radius: 999px; background: var(--chip-bg); color: var(--text); }
  .pagination a:last-child { justify-self: end; }
</style>
