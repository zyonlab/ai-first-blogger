---
import { series } from '@data/series';
import { topics, type TopicSlug } from '@data/topics';
import { formatDate } from '@lib/dates';

type Props = {
  post: {
    data: {
      title: string;
      description: string;
      slug: string;
      pubDate: Date;
      category: string;
      tags: string[];
      series?: string;
    };
  };
};

const { post } = Astro.props;
const topic = topics[post.data.category as TopicSlug];
const seriesItem = post.data.series ? series[post.data.series as keyof typeof series] : undefined;
---

<article class="card article-card">
  <div class="eyebrow">{topic?.title ?? post.data.category}</div>
  <h3><a href={`/writing/${post.data.slug}/`}>{post.data.title}</a></h3>
  <p>{post.data.description}</p>
  <div class="meta">
    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
    {seriesItem && <span>{seriesItem.title}</span>}
  </div>
  {post.data.tags.length > 0 && (
    <div class="tags">
      {post.data.tags.slice(0, 4).map((tag) => <span>{tag}</span>)}
    </div>
  )}
</article>
