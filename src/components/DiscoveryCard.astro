---
import { formatDate } from '@lib/dates';
import type { DiscoveryItem } from '@lib/discovery';

const { item, compact = false } = Astro.props as { item: DiscoveryItem; compact?: boolean };
---

<article class:list={['discovery-card', { compact }]}>
  <div class="discovery-meta">
    <span>{item.kindLabel}</span>
    {item.date && <time datetime={item.date}>{formatDate(new Date(item.date))}</time>}
  </div>
  <h3><a href={item.url}>{item.title}</a></h3>
  {!compact && <p>{item.description}</p>}
  {item.tags.length > 0 && (
    <div class="discovery-tags" aria-label="标签">
      {item.tags.slice(0, 4).map((tag) => <span>{tag}</span>)}
    </div>
  )}
</article>

<style>
  .discovery-card {
    display: grid;
    align-content: start;
    gap: 12px;
    min-width: 0;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    box-shadow: none;
  }
  .discovery-card:hover { border-color: color-mix(in srgb, var(--text), transparent 72%); }
  .discovery-meta { display: flex; justify-content: space-between; gap: 12px; color: var(--muted); font-size: .76rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
  h3 { font-size: 1.14rem; line-height: 1.3; letter-spacing: -.025em; text-wrap: balance; }
  p { margin: 0; color: var(--muted); font-size: .93rem; line-height: 1.65; }
  .discovery-tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 2px; }
  .discovery-tags span { padding: 3px 8px; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); font-size: .75rem; }
  .compact { padding: 18px; }
</style>
