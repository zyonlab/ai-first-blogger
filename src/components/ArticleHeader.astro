---
import { topics } from '@data/topics';
import { series } from '@data/series';
import { formatDate } from '@lib/dates';
import AIStudyLinks from './AIStudyLinks.astro';

type Props = {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  tags: string[];
  seriesSlug?: string;
  readingMinutes?: number;
  articleUrl: string;
};

const { title, description, pubDate, updatedDate, category, tags, seriesSlug, readingMinutes, articleUrl } = Astro.props;
const topic = topics[category as keyof typeof topics];
const seriesItem = seriesSlug ? series[seriesSlug as keyof typeof series] : undefined;
---

<header class="article-header">
  <div class="eyebrow">{topic?.title ?? category}</div>
  <h1>{title}</h1>
  <p class="article-description">{description}</p>
  <div class="meta article-meta">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    {updatedDate && <time datetime={updatedDate.toISOString()}>更新于 {formatDate(updatedDate)}</time>}
    {readingMinutes && <span>{readingMinutes} 分钟阅读</span>}
    {seriesSlug && seriesItem && <a href={`/series/${seriesSlug}/`}>{seriesItem.title}</a>}
  </div>
  {tags.length > 0 && (
    <div class="tags article-tags">
      {tags.map((tag) => <span>{tag}</span>)}
    </div>
  )}
  <AIStudyLinks title={title} description={description} url={articleUrl} />
</header>
