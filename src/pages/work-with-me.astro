---
import { site } from '@data/site';
import PageLayout from '@layouts/PageLayout.astro';
import { breadcrumbSchema, collectionPageSchema } from '@lib/schema';

const title = site.services.title;
const description = site.services.description;
const jsonLd = [
  collectionPageSchema(title, description, '/work-with-me/'),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: site.services.serviceName,
    description,
    provider: {
      '@type': 'Person',
      name: site.author.name,
      url: site.url,
    },
    areaServed: 'Global',
    serviceType: site.services.serviceTypes,
  },
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: title, url: '/work-with-me/' },
  ]),
];
---

<PageLayout title={title} description={description} canonical="/work-with-me/" jsonLd={jsonLd}>
  <section class="section grid two">
    {[
      ['品牌和网站配置', '用固定问卷收集品牌、域名、邮箱、社交媒体、导航、CTA 和视觉偏好。'],
      ['内容规划', '生成内容支柱、系列路线、关键词地图、发布节奏和首批选题。'],
      ['SEO / GEO 优化', '检查标题、摘要、结构化数据、内链、FAQ、llms.txt 和 AI 摘要友好度。'],
      ['自动部署和维护', '通过 GitHub Actions 部署到 Cloudflare Pages，并持续更新内容与站点结构。'],
    ].map(([title, description]) => (
      <article class="card">
        <h3>{title}</h3>
        <p>{description}</p>
      </article>
    ))}
  </section>
  <section class="cta-panel">
    <p>{site.services.contactText}</p>
    <div class="actions">
      <a class="button primary" href={`mailto:${site.author.email}`}>发送邮件</a>
    </div>
  </section>
</PageLayout>
