---
import NewsletterCTA from '@components/NewsletterCTA.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getPublishedCaseStudies } from '@lib/content';
import { render } from 'astro:content';
import { breadcrumbSchema } from '@lib/schema';

export async function getStaticPaths() {
  const caseStudies = await getPublishedCaseStudies();
  return caseStudies.map((item) => ({ params: { slug: item.data.slug }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const canonical = `/case-studies/${item.data.slug}/`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: item.data.title,
    description: item.data.description,
    datePublished: item.data.pubDate.toISOString(),
    dateModified: (item.data.updatedDate ?? item.data.pubDate).toISOString(),
    articleSection: item.data.category,
    keywords: item.data.tags,
  },
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Case Studies', url: '/case-studies/' },
    { name: item.data.title, url: canonical },
  ]),
];
---

<BaseLayout
  title={item.data.title}
  description={item.data.description}
  canonical={canonical}
  type="article"
  jsonLd={jsonLd}
  publishedTime={item.data.pubDate}
  modifiedTime={item.data.updatedDate ?? item.data.pubDate}
  tags={item.data.tags}
>
  <article class="article-shell">
    <header class="article-header">
      <p class="eyebrow">Case Study · {item.data.category}</p>
      <h1>{item.data.title}</h1>
      <p>{item.data.description}</p>
      <div class="tags">
        {item.data.tags.map((tag) => <span>{tag}</span>)}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
    <NewsletterCTA />
  </article>
</BaseLayout>
