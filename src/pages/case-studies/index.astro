---
import { site } from '@data/site';
import PageLayout from '@layouts/PageLayout.astro';
import { getPublishedCaseStudies } from '@lib/content';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '@lib/schema';

const caseStudies = await getPublishedCaseStudies();
const title = 'Case Studies';
const description = '从背景、约束、方案、实现和复盘角度记录工程案例。';
const jsonLd = [
  collectionPageSchema(title, description, '/case-studies/'),
  itemListSchema(
    `${site.name} Case Studies`,
    caseStudies.map((item) => ({
      name: item.data.title,
      description: item.data.description,
      url: `/case-studies/${item.data.slug}/`,
    })),
  ),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: title, url: '/case-studies/' },
  ]),
];
---

<PageLayout title={title} description={description} canonical="/case-studies/" jsonLd={jsonLd}>
  <section class="section grid two">
    {caseStudies.map((item) => (
      <article class="card">
        <p class="eyebrow">{item.data.category}</p>
        <h3><a href={`/case-studies/${item.data.slug}/`}>{item.data.title}</a></h3>
        <p>{item.data.description}</p>
        <div class="tags">
          {item.data.tags.map((tag) => <span>{tag}</span>)}
        </div>
      </article>
    ))}
  </section>
</PageLayout>
