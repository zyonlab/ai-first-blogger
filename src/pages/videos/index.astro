---
import { site } from '@data/site';
import VideoCard from '@components/VideoCard.astro';
import PageLayout from '@layouts/PageLayout.astro';
import { getPublishedVideos } from '@lib/content';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '@lib/schema';

const videos = await getPublishedVideos();
const title = '视频';
const description = '视频承接页，沉淀摘要、章节、文字稿、相关文章和项目入口。';
const jsonLd = [
  collectionPageSchema(title, description, '/videos/'),
  itemListSchema(
    `${site.name} 视频`,
    videos.map((video) => ({
      name: video.data.title,
      description: video.data.description,
      url: `/videos/${video.data.slug}/`,
    })),
  ),
  breadcrumbSchema([
    { name: '首页', url: '/' },
    { name: title, url: '/videos/' },
  ]),
];
---

<PageLayout title={title} description={description} canonical="/videos/" jsonLd={videos.length > 0 ? jsonLd : undefined} noindex={videos.length === 0}>
  {videos.length > 0 && (
    <section class="section grid">
      {videos.map((video) => <VideoCard video={video} />)}
    </section>
  )}
</PageLayout>
