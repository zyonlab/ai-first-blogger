---
import ArticleCard from '@components/ArticleCard.astro';
import SeriesCard from '@components/SeriesCard.astro';
import PageLayout from '@layouts/PageLayout.astro';
import { seriesList } from '@data/series';
import { topicList, topics, type TopicSlug } from '@data/topics';
import { getPublishedPosts } from '@lib/content';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '@lib/schema';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const activeTopicSlugs = new Set<string>(posts.map((post) => post.data.category));
  return topicList
    .filter((topic) => activeTopicSlugs.has(topic.slug))
    .map((topic) => ({ params: { slug: topic.slug } }));
}

const slug = Astro.params.slug as TopicSlug;
const topic = topics[slug];
const allPosts = await getPublishedPosts();
const posts = allPosts.filter((post) => post.data.category === slug);
const activeSeriesSlugs = new Set(allPosts.map((post) => post.data.series).filter(Boolean));
const matchedSeries = seriesList.filter((item) => item.topic === slug && activeSeriesSlugs.has(item.slug));
const canonical = `/topics/${slug}/`;
const jsonLd = [
  collectionPageSchema(topic.title, topic.description, canonical),
  itemListSchema(
    `${topic.title} Articles`,
    posts.map((post) => ({
      name: post.data.title,
      description: post.data.description,
      url: `/writing/${post.data.slug}/`,
    })),
  ),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Topics', url: '/topics/' },
    { name: topic.title, url: canonical },
  ]),
];
---

<PageLayout title={topic.title} description={topic.description} eyebrow="Topic" canonical={canonical} jsonLd={jsonLd}>
  {matchedSeries.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2>相关系列</h2>
      </div>
      <div class="grid">
        {matchedSeries.map((item) => <SeriesCard item={item} />)}
      </div>
    </section>
  )}
  {posts.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2>相关文章</h2>
      </div>
      <div class="grid two">
        {posts.map((post) => <ArticleCard post={post} />)}
      </div>
    </section>
  )}
</PageLayout>
