---
import { site } from '@data/site';
import TopicCard from '@components/TopicCard.astro';
import PageLayout from '@layouts/PageLayout.astro';
import { topicList } from '@data/topics';
import { getPublishedPosts } from '@lib/content';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '@lib/schema';

const posts = await getPublishedPosts();
const activeTopicSlugs = new Set<string>(posts.map((post) => post.data.category));
const visibleTopics = topicList.filter((topic) => activeTopicSlugs.has(topic.slug));
const title = '专题';
const description = '按长期技术主题组织文章、系列、视频和项目，方便顺着问题继续读。';
const jsonLd = [
  collectionPageSchema(title, description, '/topics/'),
  itemListSchema(
    `${site.name} 专题`,
    visibleTopics.map((topic) => ({
      name: topic.title,
      description: topic.description,
      url: `/topics/${topic.slug}/`,
    })),
  ),
  breadcrumbSchema([
    { name: '首页', url: '/' },
    { name: title, url: '/topics/' },
  ]),
];
---

<PageLayout title={title} description={description} canonical="/topics/" jsonLd={visibleTopics.length > 0 ? jsonLd : undefined} noindex={visibleTopics.length === 0}>
  {visibleTopics.length > 0 && (
    <section class="section grid">
      {visibleTopics.map((topic) => <TopicCard topic={topic} />)}
    </section>
  )}
</PageLayout>
