---
import { site } from '@data/site';
import TopicCard from '@components/TopicCard.astro';
import PageLayout from '@layouts/PageLayout.astro';
import { topicList } from '@data/topics';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '@lib/schema';

const title = 'Topics';
const description = '按长期技术主题组织文章、系列、视频和项目，形成可持续扩展的内容资产。';
const jsonLd = [
  collectionPageSchema(title, description, '/topics/'),
  itemListSchema(
    `${site.name} Topics`,
    topicList.map((topic) => ({
      name: topic.title,
      description: topic.description,
      url: `/topics/${topic.slug}/`,
    })),
  ),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: title, url: '/topics/' },
  ]),
];
---

<PageLayout title={title} description={description} canonical="/topics/" jsonLd={jsonLd}>
  <section class="section grid">
    {topicList.map((topic) => <TopicCard topic={topic} />)}
  </section>
</PageLayout>
