---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="The requested page does not exist." noindex>
  <section class="page-hero narrow">
    <p class="eyebrow">404</p>
    <h1>页面不存在</h1>
    <p>这个地址没有对应页面，可以返回首页继续浏览。</p>
    <div class="actions">
      <a class="button primary" href="/">返回首页</a>
    </div>
  </section>
</BaseLayout>
