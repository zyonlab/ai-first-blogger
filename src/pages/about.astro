---
import { site } from '@data/site';
import PageLayout from '@layouts/PageLayout.astro';
import { breadcrumbSchema, profilePageSchema } from '@lib/schema';

const title = '关于';
const description = site.author.bio;
const jsonLd = [
  profilePageSchema(),
  breadcrumbSchema([
    { name: '首页', url: '/' },
    { name: title, url: '/about/' },
  ]),
];
---

<PageLayout title={title} description={description} canonical="/about/" jsonLd={jsonLd}>
  <section class="section prose narrow">
    <h2>站点定位</h2>
    <p>{site.description}</p>
    <h2>作者 / 团队</h2>
    <p>{site.author.name} 是 {site.author.title}。{site.author.bio}</p>
    <h2>内容方向</h2>
    <ul>
      {site.brand.keywords.map((keyword) => <li>{keyword}</li>)}
    </ul>
    <h2>可合作方式</h2>
    <p>{site.services.description}</p>
  </section>
</PageLayout>
