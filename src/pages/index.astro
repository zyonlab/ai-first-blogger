---
import { site } from '@data/site';
import ArticleCard from '@components/ArticleCard.astro';
import ProjectCard from '@components/ProjectCard.astro';
import SeriesCard from '@components/SeriesCard.astro';
import TopicCard from '@components/TopicCard.astro';
import VideoCard from '@components/VideoCard.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { seriesList } from '@data/series';
import { topicList } from '@data/topics';
import { getPublishedPosts, getPublishedVideos } from '@lib/content';
import { getCollection } from 'astro:content';
import { itemListSchema, websiteSchema, personSchema } from '@lib/schema';

const posts = (await getPublishedPosts()).slice(0, 6);
const videos = (await getPublishedVideos()).slice(0, 3);
const projects = (await getCollection('projects')).slice(0, 3);
const jsonLd = [
  websiteSchema(),
  personSchema(),
  itemListSchema(
    `${site.name} Featured Content`,
    posts.map((post) => ({
      name: post.data.title,
      description: post.data.description,
      url: `/writing/${post.data.slug}/`,
    })),
  ),
];
---

<BaseLayout jsonLd={jsonLd}>
  <section class="hero">
    <div>
      <p class="eyebrow">{site.hero.eyebrow}</p>
      <h1>{site.hero.title}</h1>
      <p>{site.hero.description}</p>
      <div class="actions">
        {site.hero.actions.map((action) => (
          <a class={`button ${action.variant === 'primary' ? 'primary' : ''}`} href={action.href}>{action.label}</a>
        ))}
      </div>
    </div>
    <div class="hero-panel">
      <p class="eyebrow">内容地图</p>
      <div class="signal-grid">
        {site.hero.signals.map((signal) => <span>{signal}</span>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <p class="eyebrow">专题</p>
        <h2>长期内容方向</h2>
      </div>
      <p>围绕长期主题组织内容，而不是依赖松散标签。</p>
    </div>
    <div class="grid">
      {topicList.map((topic) => <TopicCard topic={topic} />)}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <p class="eyebrow">学习路径</p>
        <h2>系列文章</h2>
      </div>
      <a class="button" href="/series/">全部系列</a>
    </div>
    <div class="grid">
      {seriesList.map((item) => <SeriesCard item={item} />)}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <p class="eyebrow">文章</p>
        <h2>最新手记</h2>
      </div>
      <a class="button" href="/writing/">全部文章</a>
    </div>
    <div class="grid two">
      {posts.map((post) => <ArticleCard post={post} />)}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <p class="eyebrow">视频</p>
        <h2>视频与讲解</h2>
      </div>
      <p>视频页预留摘要、文字稿、章节和转化入口。</p>
    </div>
    <div class="grid">
      {videos.length > 0 ? videos.map((video) => <VideoCard video={video} />) : <p>即将更新。</p>}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <p class="eyebrow">项目</p>
        <h2>GitHub 项目与案例</h2>
      </div>
      <a class="button" href="/projects/">全部项目</a>
    </div>
    <div class="grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>
