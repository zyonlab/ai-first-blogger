---
import PageLayout from '@layouts/PageLayout.astro';
import { getDiscoveryItems, groupArchivePages, groupTagPages } from '@lib/discovery';

const items = await getDiscoveryItems();
const archiveGroups = groupArchivePages(items);
const tagGroups = groupTagPages(items);
const description = '在文章、视频、案例和项目中查找主题、技术名词与实践记录。';
---

<PageLayout title="搜索" description={description} eyebrow="Discovery" canonical="/search/" noindex>
  <section class="search-panel" data-search-root data-page-size="10">
    <form class="search-form" role="search" data-search-form>
      <label>
        <span>关键词</span>
        <input type="search" name="q" autocomplete="off" placeholder="输入主题、技术或问题" data-search-input />
      </label>
      <label>
        <span>内容类型</span>
        <select name="type" data-type-select>
          <option value="">全部</option>
          <option value="post">文章</option>
          <option value="video">视频</option>
          <option value="case-study">案例</option>
          <option value="project">项目</option>
        </select>
      </label>
      <button type="submit">搜索</button>
    </form>

    <div class="search-status" aria-live="polite" data-search-status>
      {items.length > 0 ? `可搜索 ${items.length} 项已发布内容` : '当前没有可搜索的已发布内容'}
    </div>
    <div class="search-results" data-search-results></div>
    <nav class="search-pagination" aria-label="搜索结果分页" data-search-pagination></nav>
  </section>

  {items.length > 0 && (archiveGroups.length > 0 || tagGroups.length > 0) && (
    <section class="browse-index" aria-labelledby="browse-title">
      <div>
        <p class="eyebrow">Browse</p>
        <h2 id="browse-title">按时间与标签浏览</h2>
      </div>
      {archiveGroups.length > 0 && (
        <div class="facet-group">
          <h3>年份</h3>
          <div class="facet-links">
            {archiveGroups.map((group) => <a href={`/archive/${group.slug}/`}>{group.name}<span>{group.pages[0]?.total ?? 0}</span></a>)}
          </div>
        </div>
      )}
      {tagGroups.length > 0 && (
        <div class="facet-group">
          <h3>标签</h3>
          <div class="facet-links">
            {tagGroups.map((group) => <a href={`/tags/${group.slug}/`}>{group.name}<span>{group.pages[0]?.total ?? 0}</span></a>)}
          </div>
        </div>
      )}
    </section>
  )}
</PageLayout>

<script>
  type SearchItem = {
    kind: string;
    kindLabel: string;
    title: string;
    description: string;
    url: string;
    date?: string;
    tags: string[];
    searchText: string;
  };

  const root = document.querySelector<HTMLElement>('[data-search-root]');
  const form = root?.querySelector<HTMLFormElement>('[data-search-form]');
  const input = root?.querySelector<HTMLInputElement>('[data-search-input]');
  const typeSelect = root?.querySelector<HTMLSelectElement>('[data-type-select]');
  const status = root?.querySelector<HTMLElement>('[data-search-status]');
  const results = root?.querySelector<HTMLElement>('[data-search-results]');
  const pagination = root?.querySelector<HTMLElement>('[data-search-pagination]');
  const pageSize = Number(root?.dataset.pageSize ?? 10);
  let items: SearchItem[] = [];

  function setQuery(page = 1) {
    if (!input || !typeSelect) return;
    const url = new URL(window.location.href);
    const query = input.value.trim();
    query ? url.searchParams.set('q', query) : url.searchParams.delete('q');
    typeSelect.value ? url.searchParams.set('type', typeSelect.value) : url.searchParams.delete('type');
    page > 1 ? url.searchParams.set('page', String(page)) : url.searchParams.delete('page');
    history.replaceState({}, '', url);
  }

  function createResult(item: SearchItem) {
    const article = document.createElement('article');
    article.className = 'search-result';
    const meta = document.createElement('div');
    meta.className = 'search-result-meta';
    meta.textContent = item.date
      ? `${item.kindLabel} · ${new Intl.DateTimeFormat('zh-CN', { dateStyle: 'medium' }).format(new Date(item.date))}`
      : item.kindLabel;
    const title = document.createElement('h3');
    const link = document.createElement('a');
    link.href = item.url;
    link.textContent = item.title;
    title.append(link);
    const description = document.createElement('p');
    description.textContent = item.description;
    article.append(meta, title, description);
    return article;
  }

  function render(pageOverride?: number) {
    if (!input || !typeSelect || !status || !results || !pagination) return;
    const params = new URLSearchParams(window.location.search);
    const terms = input.value.trim().toLocaleLowerCase().split(/\s+/).filter(Boolean);
    const filtered = items.filter((item) => {
      const matchesType = !typeSelect.value || item.kind === typeSelect.value;
      return matchesType && terms.every((term) => item.searchText.includes(term));
    });
    const pageCount = Math.max(1, Math.ceil(filtered.length / pageSize));
    const requestedPage = pageOverride ?? Number(params.get('page') ?? 1);
    const page = Math.min(Math.max(1, Number.isFinite(requestedPage) ? requestedPage : 1), pageCount);
    setQuery(page);
    status.textContent = terms.length > 0 || typeSelect.value
      ? `找到 ${filtered.length} 项结果`
      : `共 ${filtered.length} 项已发布内容`;
    results.replaceChildren(...filtered.slice((page - 1) * pageSize, page * pageSize).map(createResult));
    pagination.replaceChildren();
    if (pageCount <= 1) return;
    const previous = document.createElement('button');
    previous.type = 'button';
    previous.textContent = '← 上一页';
    previous.disabled = page === 1;
    previous.addEventListener('click', () => render(page - 1));
    const count = document.createElement('span');
    count.textContent = `第 ${page} / ${pageCount} 页`;
    const next = document.createElement('button');
    next.type = 'button';
    next.textContent = '下一页 →';
    next.disabled = page === pageCount;
    next.addEventListener('click', () => render(page + 1));
    pagination.append(previous, count, next);
  }

  if (input && typeSelect) {
    const params = new URLSearchParams(window.location.search);
    input.value = params.get('q') ?? '';
    typeSelect.value = params.get('type') ?? '';
    fetch('/search-index.json')
      .then((response) => response.ok ? response.json() : Promise.reject(new Error('search index unavailable')))
      .then((payload: { items: SearchItem[] }) => { items = payload.items; render(); })
      .catch(() => { if (status) status.textContent = '搜索索引暂时不可用'; });
  }
  form?.addEventListener('submit', (event) => { event.preventDefault(); render(1); });
  typeSelect?.addEventListener('change', () => render(1));
</script>

<style>
  .search-panel { padding: clamp(20px, 4vw, 34px); border: 1px solid var(--line); border-radius: 28px; background: var(--panel-bg); box-shadow: var(--panel-shadow); }
  .search-form { display: grid; grid-template-columns: minmax(0, 1fr) minmax(150px, 210px) auto; gap: 12px; align-items: end; }
  .search-form label { display: grid; gap: 7px; color: var(--muted); font-size: .76rem; font-weight: 750; letter-spacing: .06em; }
  .search-form input, .search-form select, .search-form button { min-height: 44px; border: 1px solid var(--line); border-radius: 13px; background: var(--surface); color: var(--text); font: inherit; }
  .search-form input, .search-form select { width: 100%; padding: 0 13px; }
  .search-form button { padding: 0 18px; background: var(--accent); color: var(--accent-ink); cursor: pointer; font-weight: 800; }
  .search-status { margin: 24px 0 12px; color: var(--muted); font-size: .88rem; }
  .search-results { display: grid; gap: 0; }
  :global(.search-result) { padding: 20px 0; border-top: 1px solid var(--line); }
  :global(.search-result-meta) { color: var(--accent); font-size: .72rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  :global(.search-result h3) { margin-top: 6px; font-size: 1.2rem; }
  :global(.search-result p) { max-width: 760px; margin: 7px 0 0; color: var(--muted); font-size: .93rem; }
  .search-pagination { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 14px; margin-top: 24px; color: var(--muted); font-size: .84rem; }
  .search-pagination :global(button) { width: fit-content; padding: 8px 12px; border: 1px solid var(--line); border-radius: 999px; background: var(--chip-bg); color: var(--text); cursor: pointer; }
  .search-pagination :global(button:last-child) { justify-self: end; }
  .search-pagination :global(button:disabled) { opacity: .35; cursor: default; }
  .browse-index { display: grid; grid-template-columns: minmax(220px, .7fr) minmax(0, 1fr) minmax(0, 1.4fr); gap: 28px; margin: 72px 0; padding-top: 34px; border-top: 1px solid var(--line); }
  .browse-index h2 { font-size: clamp(1.55rem, 3vw, 2.3rem); }
  .facet-group h3 { margin-bottom: 12px; font-size: .88rem; letter-spacing: .04em; }
  .facet-links { display: flex; flex-wrap: wrap; gap: 8px; }
  .facet-links a { display: inline-flex; gap: 8px; align-items: center; padding: 6px 10px; border: 1px solid var(--line); border-radius: 999px; background: var(--chip-bg); color: var(--muted); font-size: .82rem; }
  .facet-links span { color: var(--accent); font-size: .72rem; font-weight: 800; }
  @media (max-width: 760px) { .search-form, .browse-index { grid-template-columns: 1fr; } .search-form button { width: 100%; } }
</style>
