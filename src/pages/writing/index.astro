---
import { site } from '@data/site';
import ArticleCard from '@components/ArticleCard.astro';
import PageLayout from '@layouts/PageLayout.astro';
import { getPublishedPosts } from '@lib/content';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '@lib/schema';

const posts = await getPublishedPosts();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
const title = '文章';
const description = 'AI 应用、全栈工程、区块链、交易所系统、DeFi、大模型学习和开源项目手记。';
const jsonLd = [
  collectionPageSchema(title, description, '/writing/'),
  itemListSchema(
    `${site.name} 文章`,
    posts.map((post) => ({
      name: post.data.title,
      description: post.data.description,
      url: `/writing/${post.data.slug}/`,
    })),
  ),
  breadcrumbSchema([
    { name: '首页', url: '/' },
    { name: title, url: '/writing/' },
  ]),
];
---

<PageLayout title={title} description={description} canonical="/writing/" jsonLd={posts.length > 0 ? jsonLd : undefined} noindex={posts.length === 0}>
  {tags.length > 0 && (
    <section class="section">
      <div class="tags">
        {tags.map((tag) => <span>{tag}</span>)}
      </div>
    </section>
  )}
  {posts.length > 0 && (
    <section class="section grid two">
      {posts.map((post) => <ArticleCard post={post} />)}
    </section>
  )}
</PageLayout>
