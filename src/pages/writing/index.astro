---
import ArticleCard from '@components/ArticleCard.astro';
import PageLayout from '@layouts/PageLayout.astro';
import { getPublishedPosts } from '@lib/content';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '@lib/schema';

const posts = await getPublishedPosts();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
const title = 'Writing';
const description = '前端架构、Vue/React 源码、Web3、DeFi、交易所系统、工程化和 AI 工程化文章。';
const jsonLd = [
  collectionPageSchema(title, description, '/writing/'),
  itemListSchema(
    'ZyonCode Writing',
    posts.map((post) => ({
      name: post.data.title,
      description: post.data.description,
      url: `/writing/${post.data.slug}/`,
    })),
  ),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: title, url: '/writing/' },
  ]),
];
---

<PageLayout title={title} description={description} canonical="/writing/" jsonLd={jsonLd}>
  <section class="section">
    <div class="tags">
      {tags.map((tag) => <span>{tag}</span>)}
    </div>
  </section>
  <section class="section grid two">
    {posts.map((post) => <ArticleCard post={post} />)}
  </section>
</PageLayout>
