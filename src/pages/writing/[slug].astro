---
import ArticleHeader from '@components/ArticleHeader.astro';
import MermaidRenderer from '@components/MermaidRenderer.astro';
import NewsletterCTA from '@components/NewsletterCTA.astro';
import ReadingProgress from '@components/ReadingProgress.astro';
import RelatedContent from '@components/RelatedContent.astro';
import Toc from '@components/Toc.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { absoluteUrl } from '@lib/seo';
import { getPublishedPosts } from '@lib/content';
import { readingTime } from '@lib/reading-time';
import { articleSchema, breadcrumbSchema } from '@lib/schema';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const canonical = post.data.canonical ?? `/writing/${post.data.slug}/`;
const readingMinutes = readingTime(post.body ?? '');
const jsonLd = [
  articleSchema({
    title: post.data.title,
    description: post.data.description,
    canonical,
    publishedDate: post.data.pubDate,
    modifiedDate: post.data.updatedDate,
    authorName: post.data.author,
    image: post.data.heroImage,
    tags: post.data.tags,
    section: post.data.category,
  }),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Writing', url: '/writing/' },
    { name: post.data.title, url: canonical },
  ]),
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonical={canonical}
  image={post.data.heroImage}
  type="article"
  jsonLd={jsonLd}
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate ?? post.data.pubDate}
  tags={post.data.tags}
>
  <ReadingProgress />
  <article class="article-shell">
    <ArticleHeader
      title={post.data.title}
      description={post.data.description}
      pubDate={post.data.pubDate}
      updatedDate={post.data.updatedDate}
      category={post.data.category}
      tags={post.data.tags}
      seriesSlug={post.data.series}
      readingMinutes={readingMinutes}
      articleUrl={absoluteUrl(canonical)}
    />
    <div class="article-grid">
      <Toc headings={headings} />
      <div class="prose">
        <Content />
      </div>
    </div>
    <NewsletterCTA />
  </article>
  <RelatedContent kind="post" slug={post.data.slug} />
  <MermaidRenderer />
</BaseLayout>
