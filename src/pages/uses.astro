---
import PageLayout from '@layouts/PageLayout.astro';
import { breadcrumbSchema, collectionPageSchema } from '@lib/schema';

const title = 'Uses';
const description = '记录当前使用的编辑器、开发工具、AI 工具、部署平台和生产力工具。';
const jsonLd = [
  collectionPageSchema(title, description, '/uses/'),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: title, url: '/uses/' },
  ]),
];
---

<PageLayout title={title} description={description} canonical="/uses/" jsonLd={jsonLd}>
  <section class="section grid">
    {[
      ['Editor', 'VS Code / Cursor / JetBrains，根据任务切换。'],
      ['Terminal', 'zsh、pnpm、Git、Cloudflare CLI。'],
      ['AI Tools', 'Codex、代码审查工作流、文档和重构辅助。'],
      ['Deploy', 'Cloudflare Pages、GitHub、后续可接 R2。'],
      ['Web3', '节点服务、区块浏览器、DEX 分析工具。'],
      ['Productivity', 'Markdown、Mermaid、技术写作模板。'],
    ].map(([title, description]) => (
      <article class="card">
        <h3>{title}</h3>
        <p>{description}</p>
      </article>
    ))}
  </section>
</PageLayout>
