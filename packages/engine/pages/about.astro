---
import { site } from '@config/site';
import { requirePageCopy } from '@config/pages';
import { homePath, pagePath } from '@config/routes';
import PageLayout from '@layouts/PageLayout.astro';
import { breadcrumbSchema, personSchema } from '@lib/schema';

const { title, sections } = requirePageCopy('about');
const canonical = pagePath('about');
const description = site.author.bio;
const jsonLd = [
  personSchema(),
  breadcrumbSchema([
    { name: 'Home', url: homePath },
    { name: title, url: canonical },
  ]),
];
---

<PageLayout
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  breadcrumbs={[{ href: canonical, label: title }]}
>
  <section class="section prose narrow">
    {sections.map((section) => (
      <>
        <h2>{section.heading}</h2>
        {section.body === 'siteDescription' && <p>{site.description}</p>}
        {section.body === 'authorBio' && <p>{site.author.name} — {site.author.title}. {site.author.bio}</p>}
        {section.body === 'keywords' && (
          <ul>
            {site.brand.keywords.map((keyword) => <li>{keyword}</li>)}
          </ul>
        )}
        {section.body === 'services' && <p>{site.services.description}</p>}
      </>
    ))}
  </section>
</PageLayout>
