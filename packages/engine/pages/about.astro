---
import { siteFor } from '@config/site';
import { requirePageCopy } from '@config/pages';
import { localeOfPath, localeStaticPaths, locales, pagePath } from '@config/routes';
import { alternatesForPath } from '@lib/alternates';
import PageLayout from '@layouts/PageLayout.astro';
import { breadcrumbSchema, personSchema } from '@lib/schema';

export const getStaticPaths = localeStaticPaths;

const locale = localeOfPath(Astro.url.pathname);
const site = siteFor(locale);
const { title, sections } = requirePageCopy('about', locale);
const canonical = pagePath('about', locale);
const alternates = alternatesForPath('/about/', locales);
const description = site.author.bio;
const jsonLd = [
  personSchema(true, locale),
  breadcrumbSchema([{ name: title, url: canonical }], locale),
];
---

<PageLayout
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  breadcrumbs={[{ href: canonical, label: title }]}
  alternates={alternates}
>
  <section class="section prose narrow">
    {sections.map((section) => (
      <>
        <h2>{section.heading}</h2>
        {section.body === 'siteDescription' && <p>{site.description}</p>}
        {section.body === 'authorBio' && <p>{site.author.name} — {site.author.title}. {site.author.bio}</p>}
        {section.body === 'keywords' && (
          <ul>
            {site.brand.keywords.map((keyword) => <li>{keyword}</li>)}
          </ul>
        )}
        {section.body === 'services' && <p>{site.services.description}</p>}
      </>
    ))}
  </section>
</PageLayout>
