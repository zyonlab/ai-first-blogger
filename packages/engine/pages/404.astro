---
import BaseLayout from '@layouts/BaseLayout.astro';
import { t } from '@i18n/index';
---

<BaseLayout title={t('notFound.title')} description={t('notFound.description')} noindex>
  <section class="page-hero narrow">
    <p class="eyebrow">404</p>
    <h1>{t('notFound.title')}</h1>
    <p>{t('notFound.description')}</p>
    <div class="actions">
      <a class="button primary" href="/writing/">{t('notFound.readArticles')}</a>
      <a class="button" href="/topics/">{t('notFound.browseTopics')}</a>
    </div>
  </section>
</BaseLayout>
