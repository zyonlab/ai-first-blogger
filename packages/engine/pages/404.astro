---
import BaseLayout from '@layouts/BaseLayout.astro';
import { hasPage, pagePath } from '@config/routes';
import { listPath, navTypes, registry } from '@content-types/index';
import { t } from '@i18n/index';

/**
 * The one page with no locale of its own.
 *
 * A 404 is served for a URL that did not resolve, so there is no page to read a
 * locale off — and it is served by the host at the origin, which is why a
 * mounted engine does not emit one at all (ADR 0005). On a bilingual site it is
 * the default language's 404, which is the same answer every static host gives.
 */

/**
 * The two ways out are looked up, not written down.
 *
 * The first button used to point at `/writing/` literally — one site's route
 * for one content type. A site that called its posts anything else shipped a
 * 404 page whose own escape route 404s, which is a hard defect to notice
 * because nobody visits their own 404 page.
 */
const listType = navTypes[0] ?? registry[0];
---

<BaseLayout title={t('notFound.title')} description={t('notFound.description')} noindex>
  <section class="page-hero narrow">
    <p class="eyebrow">404</p>
    <h1>{t('notFound.title')}</h1>
    <p>{t('notFound.description')}</p>
    <div class="actions">
      {listType && <a class="button primary" href={listPath(listType)}>{t('notFound.readArticles')}</a>}
      {hasPage('topics') && <a class="button" href={pagePath('topics')}>{t('notFound.browseTopics')}</a>}
    </div>
  </section>
</BaseLayout>
