---
import { site } from '@config/site';
import { requirePageCopy } from '@config/pages';
import { homePath, pagePath } from '@config/routes';
import PageLayout from '@layouts/PageLayout.astro';
import { breadcrumbSchema, collectionPageSchema } from '@lib/schema';

const { title, description, body, action } = requirePageCopy('newsletter');
const canonical = pagePath('newsletter');
const jsonLd = [
  collectionPageSchema(title, description, canonical),
  breadcrumbSchema([
    { name: 'Home', url: homePath },
    { name: title, url: canonical },
  ]),
];
---

<PageLayout
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  breadcrumbs={[{ href: canonical, label: title }]}
>
  <section class="cta-panel">
    <p>{body}</p>
    <div class="actions">
      <a class="button primary" href={`mailto:${site.author.email}?subject=Subscribe ${site.name}`}>{action}</a>
    </div>
  </section>
</PageLayout>
