---
import { siteFor } from '@config/site';
import { requirePageCopy } from '@config/pages';
import { localeOfPath, localeStaticPaths, locales, pagePath } from '@config/routes';
import { alternatesForPath } from '@lib/alternates';
import PageLayout from '@layouts/PageLayout.astro';
import { breadcrumbSchema, collectionPageSchema } from '@lib/schema';

export const getStaticPaths = localeStaticPaths;

const locale = localeOfPath(Astro.url.pathname);
const site = siteFor(locale);
const { title, description, body, action } = requirePageCopy('newsletter', locale);
const canonical = pagePath('newsletter', locale);
const alternates = alternatesForPath('/newsletter/', locales);
const jsonLd = [
  collectionPageSchema(title, description, canonical, locale),
  breadcrumbSchema([{ name: title, url: canonical }], locale),
];
---

<PageLayout
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  breadcrumbs={[{ href: canonical, label: title }]}
  alternates={alternates}
>
  <section class="cta-panel">
    <p>{body}</p>
    <div class="actions">
      <a class="button primary" href={`mailto:${site.author.email}?subject=Subscribe ${site.name}`}>{action}</a>
    </div>
  </section>
</PageLayout>
