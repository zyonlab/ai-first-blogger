---
import { site } from '@config/site';
import { pages } from '@config/pages';
import PageLayout from '@layouts/PageLayout.astro';
import { breadcrumbSchema, collectionPageSchema } from '@lib/schema';

const { title, description, body, action } = pages.newsletter;
const jsonLd = [
  collectionPageSchema(title, description, '/newsletter/'),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: title, url: '/newsletter/' },
  ]),
];
---

<PageLayout
  title={title}
  description={description}
  canonical="/newsletter/"
  jsonLd={jsonLd}
  breadcrumbs={[{ href: '/newsletter/', label: title }]}
>
  <section class="cta-panel">
    <p>{body}</p>
    <div class="actions">
      <a class="button primary" href={`mailto:${site.author.email}?subject=Subscribe ${site.name}`}>{action}</a>
    </div>
  </section>
</PageLayout>
