---
import PageLayout from '@layouts/PageLayout.astro';
import { requirePageCopy } from '@config/pages';
import { homePath, pagePath } from '@config/routes';
import { breadcrumbSchema, collectionPageSchema } from '@lib/schema';

const { title, description, items } = requirePageCopy('uses');
const canonical = pagePath('uses');
const jsonLd = [
  collectionPageSchema(title, description, canonical),
  breadcrumbSchema([
    { name: 'Home', url: homePath },
    { name: title, url: canonical },
  ]),
];
---

<PageLayout
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  breadcrumbs={[{ href: canonical, label: title }]}
>
  <section class="section grid">
    {items.map(({ name, body: note }) => (
      <article class="card">
        <h2>{name}</h2>
        <p>{note}</p>
      </article>
    ))}
  </section>
</PageLayout>
