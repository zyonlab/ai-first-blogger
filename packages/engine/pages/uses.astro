---
import PageLayout from '@layouts/PageLayout.astro';
import { pages } from '@config/pages';
import { breadcrumbSchema, collectionPageSchema } from '@lib/schema';

const { title, description, items } = pages.uses;
const jsonLd = [
  collectionPageSchema(title, description, '/uses/'),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: title, url: '/uses/' },
  ]),
];
---

<PageLayout
  title={title}
  description={description}
  canonical="/uses/"
  jsonLd={jsonLd}
  breadcrumbs={[{ href: '/uses/', label: title }]}
>
  <section class="section grid">
    {items.map(({ name, body: note }) => (
      <article class="card">
        <h2>{name}</h2>
        <p>{note}</p>
      </article>
    ))}
  </section>
</PageLayout>
