---
import PageLayout from '@layouts/PageLayout.astro';
import { requirePageCopy } from '@config/pages';
import { localeOfPath, localeStaticPaths, locales, pagePath } from '@config/routes';
import { alternatesForPath } from '@lib/alternates';
import { breadcrumbSchema, collectionPageSchema } from '@lib/schema';

export const getStaticPaths = localeStaticPaths;

const locale = localeOfPath(Astro.url.pathname);
const { title, description, items } = requirePageCopy('uses', locale);
const canonical = pagePath('uses', locale);
const alternates = alternatesForPath('/uses/', locales);
const jsonLd = [
  collectionPageSchema(title, description, canonical, locale),
  breadcrumbSchema([{ name: title, url: canonical }], locale),
];
---

<PageLayout
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  breadcrumbs={[{ href: canonical, label: title }]}
  alternates={alternates}
>
  <section class="section grid">
    {items.map(({ name, body: note }) => (
      <article class="card">
        <h2>{name}</h2>
        <p>{note}</p>
      </article>
    ))}
  </section>
</PageLayout>
