---
import { site } from '@config/site';
import { requirePageCopy } from '@config/pages';
import { homePath, pagePath } from '@config/routes';
import PageLayout from '@layouts/PageLayout.astro';
import { breadcrumbSchema, collectionPageSchema } from '@lib/schema';

const title = site.services.title;
const description = site.services.description;
const { services, action } = requirePageCopy('workWithMe');
const canonical = pagePath('work-with-me');
const jsonLd = [
  collectionPageSchema(title, description, canonical),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: site.services.serviceName,
    description,
    provider: {
      '@type': 'Person',
      name: site.author.name,
      url: site.url,
    },
    areaServed: 'Global',
    serviceType: site.services.serviceTypes,
  },
  breadcrumbSchema([
    { name: 'Home', url: homePath },
    { name: title, url: canonical },
  ]),
];
---

<PageLayout
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  breadcrumbs={[{ href: canonical, label: title }]}
>
  <section class="section grid two">
    {services.map(({ name, body: note }) => (
      <article class="card">
        <h2>{name}</h2>
        <p>{note}</p>
      </article>
    ))}
  </section>
  <section class="cta-panel">
    <p>{site.services.contactText}</p>
    <div class="actions">
      <a class="button primary" href={`mailto:${site.author.email}`}>{action}</a>
    </div>
  </section>
</PageLayout>
