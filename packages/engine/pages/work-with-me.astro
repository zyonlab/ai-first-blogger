---
import { siteFor } from '@config/site';
import { requirePageCopy } from '@config/pages';
import { localeOfPath, localeStaticPaths, locales, pagePath } from '@config/routes';
import { alternatesForPath } from '@lib/alternates';
import PageLayout from '@layouts/PageLayout.astro';
import { breadcrumbSchema, collectionPageSchema } from '@lib/schema';

export const getStaticPaths = localeStaticPaths;

const locale = localeOfPath(Astro.url.pathname);
const site = siteFor(locale);
const title = site.services.title;
const description = site.services.description;
const { services, action } = requirePageCopy('workWithMe', locale);
const canonical = pagePath('work-with-me', locale);
const alternates = alternatesForPath('/work-with-me/', locales);
const jsonLd = [
  collectionPageSchema(title, description, canonical, locale),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: site.services.serviceName,
    description,
    provider: {
      '@type': 'Person',
      name: site.author.name,
      url: site.url,
    },
    areaServed: 'Global',
    serviceType: site.services.serviceTypes,
  },
  breadcrumbSchema([{ name: title, url: canonical }], locale),
];
---

<PageLayout
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  breadcrumbs={[{ href: canonical, label: title }]}
  alternates={alternates}
>
  <section class="section grid two">
    {services.map(({ name, body: note }) => (
      <article class="card">
        <h2>{name}</h2>
        <p>{note}</p>
      </article>
    ))}
  </section>
  <section class="cta-panel">
    <p>{site.services.contactText}</p>
    <div class="actions">
      <a class="button primary" href={`mailto:${site.author.email}`}>{action}</a>
    </div>
  </section>
</PageLayout>
