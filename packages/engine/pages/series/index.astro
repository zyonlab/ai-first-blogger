---
import { site } from '@config/site';
import SeriesCard from '@components/SeriesCard.astro';
import PageLayout from '@layouts/PageLayout.astro';
import { requirePageCopy } from '@config/pages';
import { homePath, pagePath, seriesPath } from '@config/routes';
import { getActiveSeries } from '@lib/taxonomy';
import { t } from '@i18n/index';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '@lib/schema';

const { title, description } = requirePageCopy('series');
const canonical = pagePath('series');
const seriesList = await getActiveSeries();
const jsonLd = [
  collectionPageSchema(title, description, canonical),
  itemListSchema(
    `${site.name} Series`,
    seriesList.map((item) => ({
      name: item.title,
      description: item.description,
      url: seriesPath(item.slug),
    })),
  ),
  breadcrumbSchema([
    { name: 'Home', url: homePath },
    { name: title, url: canonical },
  ]),
];
---

<PageLayout
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  breadcrumbs={[{ href: canonical, label: title }]}
>
  <section data-item-list class="section grid">
    {seriesList.length > 0
      ? seriesList.map((item) => <SeriesCard item={item} headingLevel={2} />)
      : <p>{t('taxonomy.empty')}</p>}
  </section>
</PageLayout>
