---
import { siteFor } from '@config/site';
import SeriesCard from '@components/SeriesCard.astro';
import PageLayout from '@layouts/PageLayout.astro';
import { requirePageCopy } from '@config/pages';
import { homePath, localeOfPath, localeStaticPaths, locales, pagePath, seriesPath } from '@config/routes';
import { getActiveSeries } from '@lib/taxonomy';
import { alternatesForPath } from '@lib/alternates';
import { messages } from '@i18n/index';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '@lib/schema';

export const getStaticPaths = localeStaticPaths;

const locale = localeOfPath(Astro.url.pathname);
const site = siteFor(locale);
const t = messages(locale);
const { title, description } = requirePageCopy('series', locale);
const canonical = pagePath('series', locale);
const seriesList = await getActiveSeries(locale);
const alternates = alternatesForPath('/series/', locales);
const jsonLd = [
  collectionPageSchema(title, description, canonical, locale),
  itemListSchema(
    `${site.name} Series`,
    seriesList.map((item) => ({
      name: item.title,
      description: item.description,
      url: seriesPath(item.slug, locale),
    })),
  ),
  breadcrumbSchema([
    { name: 'Home', url: homePath(locale) },
    { name: title, url: canonical },
  ]),
];
---

<PageLayout
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  breadcrumbs={[{ href: canonical, label: title }]}
  alternates={alternates}
>
  <section data-item-list class="section grid">
    {seriesList.length > 0
      ? seriesList.map((item) => <SeriesCard item={item} headingLevel={2} />)
      : <p>{t('taxonomy.empty')}</p>}
  </section>
</PageLayout>
