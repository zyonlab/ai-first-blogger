---
import PageLayout from '@layouts/PageLayout.astro';
import { localeOfPath, localeParam, localeParams, locales, pagePath, seriesPath } from '@config/routes';
import { seriesFor } from '@config/taxonomy';
import { getActiveSeries } from '@lib/taxonomy';
import { entryPath, registryFor } from '@content-types/index';
import { alternatesForPath } from '@lib/alternates';
import { assertSameOrigin, seoFromFields } from '@lib/seo';
import { findEntries } from '@lib/content';
import { cardFor } from '@lib/renderers';
import { messages } from '@i18n/index';
import { requirePageCopy } from '@config/pages';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '@lib/schema';

export async function getStaticPaths() {
  const perLocale = await Promise.all(
    localeParams().map(async ({ locale, param }) =>
      (await getActiveSeries(locale)).map((item) => ({ params: { ...localeParam(param), slug: item.slug } })),
    ),
  );
  return perLocale.flat();
}

const locale = localeOfPath(Astro.url.pathname);
const t = messages(locale);
const slug = Astro.params.slug as string;
const item = seriesFor(locale)[slug]!;

const matches = (await findEntries(registryFor(locale), (entry) => entry.data.series === slug, locale)).sort(
  (a, b) => ((a.entry.data.seriesOrder as number) ?? 999) - ((b.entry.data.seriesOrder as number) ?? 999),
);
// An archive may override its canonical, and is held to the same rule an
// entry is (C-07): a cross-origin one hands this page's ranking away, and
// on an archive that reads like tidying up after a domain move.
const canonical = assertSameOrigin(item.canonical, seriesPath(slug, locale), 'series/' + slug);

const built = (
  await Promise.all(
    locales.map(async (tag) => ((await getActiveSeries(tag)).some((entry) => entry.slug === slug) ? tag : undefined)),
  )
).filter((tag): tag is string => tag !== undefined);
const alternates = alternatesForPath(`/series/${slug}/`, built);

const jsonLd = [
  collectionPageSchema(item.title, item.description, canonical, locale),
  itemListSchema(
    `${item.title} Reading Path`,
    matches.map(({ type, entry }) => ({
      name: entry.data.title as string,
      description: entry.data.description as string,
      url: entryPath(type, entry.data.slug, locale),
    })),
  ),
  breadcrumbSchema(
    [
      { name: requirePageCopy('series', locale).title, url: pagePath('series', locale) },
      { name: item.title, url: canonical },
    ],
    locale,
  ),
];
---

<PageLayout
  title={item.title}
  description={item.description}
  eyebrow="Series"
  canonical={canonical}
  jsonLd={jsonLd}
  breadcrumbs={[{ href: pagePath('series', locale), label: 'Series' }, { href: canonical, label: item.title }]}
  alternates={alternates}
  seo={seoFromFields(item)}
  heroImage={item.heroImage}
  heroImageAlt={item.heroImageAlt}
>
  <section data-item-list class="section">
    <div class="section-head">
      <h2>{t('taxonomy.readingOrder')}</h2>
      <p>{t('taxonomy.readingOrderHint')}</p>
    </div>
    <div class="grid two">
      {matches.map(({ type, entry }) => {
        const Card = cardFor(type.card);
        return <Card entry={entry} type={type} />;
      })}
    </div>
  </section>
</PageLayout>
