---
import { site } from '@config/site';
import TopicCard from '@components/TopicCard.astro';
import PageLayout from '@layouts/PageLayout.astro';
import { pages } from '@config/pages';
import { getActiveTopics } from '@lib/taxonomy';
import { t } from '@i18n/index';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '@lib/schema';

const { title, description } = pages.topics;
const topicList = await getActiveTopics();
const jsonLd = [
  collectionPageSchema(title, description, '/topics/'),
  itemListSchema(
    `${site.name} Topics`,
    topicList.map((topic) => ({
      name: topic.title,
      description: topic.description,
      url: `/topics/${topic.slug}/`,
    })),
  ),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: title, url: '/topics/' },
  ]),
];
---

<PageLayout
  title={title}
  description={description}
  canonical="/topics/"
  jsonLd={jsonLd}
  breadcrumbs={[{ href: '/topics/', label: title }]}
>
  <section data-item-list class="section grid">
    {topicList.length > 0
      ? topicList.map((topic) => <TopicCard topic={topic} headingLevel={2} />)
      : <p>{t('taxonomy.empty')}</p>}
  </section>
</PageLayout>
