---
import { site } from '@config/site';
import TopicCard from '@components/TopicCard.astro';
import PageLayout from '@layouts/PageLayout.astro';
import { requirePageCopy } from '@config/pages';
import { homePath, pagePath, topicPath } from '@config/routes';
import { getActiveTopics } from '@lib/taxonomy';
import { t } from '@i18n/index';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '@lib/schema';

const { title, description } = requirePageCopy('topics');
const canonical = pagePath('topics');
const topicList = await getActiveTopics();
const jsonLd = [
  collectionPageSchema(title, description, canonical),
  itemListSchema(
    `${site.name} Topics`,
    topicList.map((topic) => ({
      name: topic.title,
      description: topic.description,
      url: topicPath(topic.slug),
    })),
  ),
  breadcrumbSchema([
    { name: 'Home', url: homePath },
    { name: title, url: canonical },
  ]),
];
---

<PageLayout
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  breadcrumbs={[{ href: canonical, label: title }]}
>
  <section data-item-list class="section grid">
    {topicList.length > 0
      ? topicList.map((topic) => <TopicCard topic={topic} headingLevel={2} />)
      : <p>{t('taxonomy.empty')}</p>}
  </section>
</PageLayout>
