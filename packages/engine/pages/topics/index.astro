---
import { siteFor } from '@config/site';
import TopicCard from '@components/TopicCard.astro';
import PageLayout from '@layouts/PageLayout.astro';
import { requirePageCopy } from '@config/pages';
import { homePath, localeOfPath, localeStaticPaths, locales, pagePath, topicPath } from '@config/routes';
import { getActiveTopics } from '@lib/taxonomy';
import { alternatesForPath } from '@lib/alternates';
import { messages } from '@i18n/index';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '@lib/schema';

export const getStaticPaths = localeStaticPaths;

const locale = localeOfPath(Astro.url.pathname);
const site = siteFor(locale);
const t = messages(locale);
const { title, description } = requirePageCopy('topics', locale);
const canonical = pagePath('topics', locale);
const topicList = await getActiveTopics(locale);
const alternates = alternatesForPath('/topics/', locales);
const jsonLd = [
  collectionPageSchema(title, description, canonical, locale),
  itemListSchema(
    `${site.name} Topics`,
    topicList.map((topic) => ({
      name: topic.title,
      description: topic.description,
      url: topicPath(topic.slug, locale),
    })),
  ),
  breadcrumbSchema([
    { name: 'Home', url: homePath(locale) },
    { name: title, url: canonical },
  ]),
];
---

<PageLayout
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  breadcrumbs={[{ href: canonical, label: title }]}
  alternates={alternates}
>
  <section data-item-list class="section grid">
    {topicList.length > 0
      ? topicList.map((topic) => <TopicCard topic={topic} headingLevel={2} />)
      : <p>{t('taxonomy.empty')}</p>}
  </section>
</PageLayout>
