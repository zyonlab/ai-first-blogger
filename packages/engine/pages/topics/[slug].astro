---
import SeriesCard from '@components/SeriesCard.astro';
import PageLayout from '@layouts/PageLayout.astro';
import { hasPage, localeOfPath, localeParam, localeParams, locales, pagePath, topicPath } from '@config/routes';
import { seriesListFor, topicsFor, type TopicSlug } from '@config/taxonomy';
import { getActiveTopics } from '@lib/taxonomy';
import { entryPath, registryFor } from '@content-types/index';
import { alternatesForPath } from '@lib/alternates';
import { assertSameOrigin, seoFromFields } from '@lib/seo';
import { findEntries } from '@lib/content';
import { cardFor } from '@lib/renderers';
import { messages } from '@i18n/index';
import { requirePageCopy } from '@config/pages';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '@lib/schema';

export async function getStaticPaths() {
  // Only topics that actually have entries *in this locale* — an empty topic
  // page is thin content that still ends up in the sitemap, and a topic whose
  // three articles are all in Chinese has nothing to show an English reader.
  const perLocale = await Promise.all(
    localeParams().map(async ({ locale, param }) =>
      (await getActiveTopics(locale)).map((topic) => ({ params: { ...localeParam(param), slug: topic.slug } })),
    ),
  );
  return perLocale.flat();
}

const locale = localeOfPath(Astro.url.pathname);
const t = messages(locale);
const slug = Astro.params.slug as TopicSlug;
const topic = topicsFor(locale)[slug]!;

// Collects from every content type that carries a `category`, not just posts.
const matches = await findEntries(registryFor(locale), (entry) => entry.data.category === slug, locale);
const matchedSeries = hasPage('series') ? seriesListFor(locale).filter((item) => item.topic === slug) : [];
// An archive may override its canonical, and is held to the same rule an
// entry is (C-07): a cross-origin one hands this page's ranking away, and
// on an archive that reads like tidying up after a domain move.
const canonical = assertSameOrigin(topic.canonical, topicPath(slug, locale), 'topics/' + slug);

// A topic page exists in a locale when that locale has an entry in the topic,
// which is the same question getStaticPaths asked. Asking it again here rather
// than assuming every locale built it is the difference between an hreflang set
// and an hreflang guess.
const built = (
  await Promise.all(
    locales.map(async (tag) => ((await getActiveTopics(tag)).some((item) => item.slug === slug) ? tag : undefined)),
  )
).filter((tag): tag is string => tag !== undefined);
const alternates = alternatesForPath(`/topics/${slug}/`, built);

const jsonLd = [
  collectionPageSchema(topic.title, topic.description, canonical, locale),
  itemListSchema(
    `${topic.title} Content`,
    matches.map(({ type, entry }) => ({
      name: entry.data.title as string,
      description: entry.data.description as string,
      url: entryPath(type, entry.data.slug, locale),
    })),
  ),
  breadcrumbSchema(
    [
      { name: requirePageCopy('topics', locale).title, url: pagePath('topics', locale) },
      { name: topic.title, url: canonical },
    ],
    locale,
  ),
];
---

<PageLayout
  title={topic.title}
  description={topic.description}
  eyebrow="Topic"
  canonical={canonical}
  jsonLd={jsonLd}
  breadcrumbs={[{ href: pagePath('topics', locale), label: 'Topics' }, { href: canonical, label: topic.title }]}
  alternates={alternates}
  seo={seoFromFields(topic)}
  heroImage={topic.heroImage}
  heroImageAlt={topic.heroImageAlt}
>
  {matchedSeries.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2>{t('taxonomy.featuredSeries')}</h2>
      </div>
      <div class="grid">
        {matchedSeries.map((item) => <SeriesCard item={item} />)}
      </div>
    </section>
  )}
  <section data-item-list class="section">
    <div class="section-head">
      <h2>{t('taxonomy.relatedContent')}</h2>
    </div>
    <div class="grid two">
      {matches.map(({ type, entry }) => {
        const Card = cardFor(type.card);
        return <Card entry={entry} type={type} />;
      })}
    </div>
  </section>
</PageLayout>
