---
import SeriesCard from '@components/SeriesCard.astro';
import PageLayout from '@layouts/PageLayout.astro';
import { hasPage, homePath, pagePath, topicPath } from '@config/routes';
import { seriesList, topics, type TopicSlug } from '@config/taxonomy';
import { getActiveTopics } from '@lib/taxonomy';
import { entryPath, registry } from '@content-types/index';
import { findEntries } from '@lib/content';
import { cardFor } from '@lib/renderers';
import { t } from '@i18n/index';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '@lib/schema';

export async function getStaticPaths() {
  // Only topics that actually have entries — an empty topic page is thin
  // content that still ends up in the sitemap.
  return (await getActiveTopics()).map((topic) => ({ params: { slug: topic.slug } }));
}

const slug = Astro.params.slug as TopicSlug;
const topic = topics[slug];

// Collects from every content type that carries a `category`, not just posts.
const matches = await findEntries(registry, (entry) => entry.data.category === slug);
const matchedSeries = hasPage('series') ? seriesList.filter((item) => item.topic === slug) : [];
const canonical = topicPath(slug);

const jsonLd = [
  collectionPageSchema(topic.title, topic.description, canonical),
  itemListSchema(
    `${topic.title} Content`,
    matches.map(({ type, entry }) => ({
      name: entry.data.title as string,
      description: entry.data.description as string,
      url: entryPath(type, entry.data.slug),
    })),
  ),
  breadcrumbSchema([
    { name: 'Home', url: homePath },
    { name: 'Topics', url: pagePath('topics') },
    { name: topic.title, url: canonical },
  ]),
];
---

<PageLayout
  title={topic.title}
  description={topic.description}
  eyebrow="Topic"
  canonical={canonical}
  jsonLd={jsonLd}
  breadcrumbs={[{ href: pagePath('topics'), label: 'Topics' }, { href: canonical, label: topic.title }]}
>
  {matchedSeries.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2>{t('taxonomy.featuredSeries')}</h2>
      </div>
      <div class="grid">
        {matchedSeries.map((item) => <SeriesCard item={item} />)}
      </div>
    </section>
  )}
  <section data-item-list class="section">
    <div class="section-head">
      <h2>{t('taxonomy.relatedContent')}</h2>
    </div>
    <div class="grid two">
      {matches.map(({ type, entry }) => {
        const Card = cardFor(type.card);
        return <Card entry={entry} type={type} />;
      })}
    </div>
  </section>
</PageLayout>
