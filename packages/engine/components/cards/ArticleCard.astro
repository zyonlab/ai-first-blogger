---
import { localeOfPath } from '@config/routes';
import { seriesFor, topicsFor } from '@config/taxonomy';
import { entryPath } from '@content-types/index';
import { localeOf } from '@lib/content';
import { formatDate } from '@lib/dates';
import type { CardProps } from './card-props';

const { entry, type, headingLevel = 3 } = Astro.props as CardProps;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const data = entry.data as {
  title: string;
  description: string;
  slug: string;
  pubDate: Date;
  category: string;
  tags: string[];
  series?: string;
};
// The card's own locale is the *entry's*, not the page's. They are the same on
// every surface the engine renders today, and taking it from the entry is what
// keeps that true if a page ever lists across languages: a link to an article
// must point at the URL that article was built at.
const locale = localeOf(entry);
const topic = topicsFor(locale)[data.category];
const seriesItem = data.series ? seriesFor(locale)[data.series] : undefined;
const href = entryPath(type, data.slug, locale);
---

<article class="card article-card">
  <div class="eyebrow">{topic?.title ?? data.category}</div>
  <Heading><a href={href}>{data.title}</a></Heading>
  <p>{data.description}</p>
  <div class="meta">
    <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate, locale)}</time>
    {seriesItem && <span>{seriesItem.title}</span>}
  </div>
  {data.tags.length > 0 && (
    <div class="tags">
      {data.tags.slice(0, 4).map((tag) => <span>{tag}</span>)}
    </div>
  )}
</article>
