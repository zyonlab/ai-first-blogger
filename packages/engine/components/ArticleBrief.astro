---
/**
 * Sticky side rail for an article: summary, metadata and the AI study links.
 *
 * Lives in the content grid rather than the header so that on wide screens it
 * becomes a third column beside the prose instead of leaving dead space there.
 */
import { hasPage, seriesPath } from '@config/routes';
import { series, topics } from '@config/taxonomy';
import { t } from '@i18n/index';
import AIStudyLinks from './AIStudyLinks.astro';

type Props = {
  title: string;
  description: string;
  category: string;
  seriesSlug?: string;
  readingMinutes?: number;
  articleUrl: string;
};

const { title, description, category, seriesSlug, readingMinutes, articleUrl } = Astro.props;
const topic = topics[category as keyof typeof topics];
const seriesItem = seriesSlug ? series[seriesSlug as keyof typeof series] : undefined;
---

<aside class="article-brief" aria-label={t('article.overview')}>
  <div class="article-brief-card">
    <strong>{t('article.brief')}</strong>
    <p>{description}</p>
    <dl>
      <div>
        <dt>Topic</dt>
        <dd>{topic?.title ?? category}</dd>
      </div>
      {readingMinutes && (
        <div>
          <dt>Read</dt>
          <dd>{readingMinutes} min</dd>
        </div>
      )}
      {seriesItem && (
        <div>
          <dt>Series</dt>
          <dd>{hasPage('series') && seriesSlug
            ? <a href={seriesPath(seriesSlug)}>{seriesItem.title}</a>
            : seriesItem.title}</dd>
        </div>
      )}
    </dl>
    <AIStudyLinks title={title} description={description} url={articleUrl} />
  </div>
</aside>
