---
import { localeOfPath } from '@config/routes';
import { siteFor } from '@config/site';
import type { Alternate } from '@lib/alternates';
import { xDefault } from '@lib/alternates';
import { absoluteUrl } from '@lib/seo';
import { ogLocaleOf } from '@i18n/index';

type Props = {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  tags?: string[];
  /**
   * What the social card says, when it should not be what the head says.
   *
   * Each falls back to the next thing out — twitter to og, og to the page —
   * so a page that overrides one of the six is not silently blanking the other
   * five. Absent everywhere is the behaviour every page had before these
   * existed.
   */
  ogTitle?: string;
  ogDescription?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  twitterImage?: string;
  /**
   * The same page in other languages, including this one. Empty on a
   * single-language site and on a page that exists in one language only —
   * see @lib/alternates for why nothing here infers the set.
   */
  alternates?: Alternate[];
};

const locale = localeOfPath(Astro.url.pathname);
const site = siteFor(locale);

const {
  title,
  description,
  canonical = Astro.url.pathname,
  image = site.og.default,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  tags = [],
  ogTitle,
  ogDescription,
  twitterTitle,
  twitterDescription,
  twitterImage,
  alternates = [],
} = Astro.props;

const defaultHref = xDefault(alternates);

// The home page uses site.title verbatim; every other page goes through the
// site's own title template (site/site.yaml → titleTemplate).
// A preview deploy is the same site on another hostname; indexing it splits
// the authority of every page with its production twin.
const isPreview = import.meta.env.DEPLOY_CONTEXT === 'preview';

const pageTitle =
  title === site.name
    ? site.title
    : site.titleTemplate.replace('{title}', title).replace('{name}', site.name);
const canonicalUrl = absoluteUrl(canonical);
const imageUrl = absoluteUrl(image);

/**
 * The card, resolved outward: twitter → og → the page.
 *
 * `pageTitle` rather than `title` on purpose — a card that skipped the site's
 * titleTemplate would be the one string on the page not wearing the site's
 * name, which is a difference nobody chose and everybody notices in a share
 * preview.
 */
const cardTitle = ogTitle ?? pageTitle;
const cardDescription = ogDescription ?? description;
const twitterCardTitle = twitterTitle ?? cardTitle;
const twitterCardDescription = twitterDescription ?? cardDescription;
const twitterImageUrl = twitterImage ? absoluteUrl(twitterImage) : imageUrl;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={site.author.name} />
<meta name="robots" content={noindex || isPreview ? 'noindex,nofollow' : 'index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1'} />
<link rel="canonical" href={canonicalUrl} />
{alternates.map((alternate) => (
  <link rel="alternate" hreflang={alternate.locale} href={absoluteUrl(alternate.href)} />
))}
{defaultHref && <link rel="alternate" hreflang="x-default" href={absoluteUrl(defaultHref)} />}
<meta property="og:title" content={cardTitle} />
<meta property="og:description" content={cardDescription} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={ogLocaleOf(locale)} />
{alternates
  .filter((alternate) => alternate.locale !== locale)
  .map((alternate) => <meta property="og:locale:alternate" content={ogLocaleOf(alternate.locale)} />)}
{type === 'article' && publishedTime && <meta property="article:published_time" content={new Date(publishedTime).toISOString()} />}
{type === 'article' && modifiedTime && <meta property="article:modified_time" content={new Date(modifiedTime).toISOString()} />}
{type === 'article' && <meta property="article:author" content={site.author.name} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={twitterCardTitle} />
<meta name="twitter:description" content={twitterCardDescription} />
<meta name="twitter:image" content={twitterImageUrl} />
