---
type Crumb = {
  href: string;
  label: string;
};

type Props = {
  items: Crumb[];
};

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/">Home</a>
  {items.map((item) => (
    <>
      <span aria-hidden="true">/</span>
      <a href={item.href}>{item.label}</a>
    </>
  ))}
</nav>
