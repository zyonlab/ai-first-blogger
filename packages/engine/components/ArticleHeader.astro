---
import { hasPage, localeOfPath, seriesPath } from '@config/routes';
import { seriesFor, topicsFor } from '@config/taxonomy';
import { messages } from '@i18n/index';
import { formatDate } from '@lib/dates';

type Props = {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  tags: string[];
  seriesSlug?: string;
  readingMinutes?: number;
};

const { title, description, pubDate, updatedDate, category, tags, seriesSlug, readingMinutes } = Astro.props;
const locale = localeOfPath(Astro.url.pathname);
const t = messages(locale);
const topic = topicsFor(locale)[category];
const seriesItem = seriesSlug ? seriesFor(locale)[seriesSlug] : undefined;
---

<header class="article-header">
  <div class="article-header-main">
    <div class="eyebrow">{topic?.title ?? category}</div>
    <h1>{title}</h1>
    <p>{description}</p>
    <div class="meta">
      <time datetime={pubDate.toISOString()}>{t('article.publishedOn', { date: formatDate(pubDate, locale) })}</time>
      {updatedDate && <time datetime={updatedDate.toISOString()}>{t('article.updatedOn', { date: formatDate(updatedDate, locale) })}</time>}
      {readingMinutes && <span>{t('article.readingTime', { minutes: readingMinutes })}</span>}
      {seriesSlug && seriesItem && (hasPage('series')
        ? <a href={seriesPath(seriesSlug, locale)}>{seriesItem.title}</a>
        : <span>{seriesItem.title}</span>)}
    </div>
    {tags.length > 0 && (
      <div class="tags">
        {tags.map((tag) => <span>{tag}</span>)}
      </div>
    )}
  </div>
</header>
