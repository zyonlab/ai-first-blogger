---
import { hasPage, seriesPath } from '@config/routes';
import { series, topics } from '@config/taxonomy';
import { t } from '@i18n/index';
import { formatDate } from '@lib/dates';

type Props = {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  tags: string[];
  seriesSlug?: string;
  readingMinutes?: number;
};

const { title, description, pubDate, updatedDate, category, tags, seriesSlug, readingMinutes } = Astro.props;
const topic = topics[category as keyof typeof topics];
const seriesItem = seriesSlug ? series[seriesSlug as keyof typeof series] : undefined;
---

<header class="article-header">
  <div class="article-header-main">
    <div class="eyebrow">{topic?.title ?? category}</div>
    <h1>{title}</h1>
    <p>{description}</p>
    <div class="meta">
      <time datetime={pubDate.toISOString()}>{t('article.publishedOn', { date: formatDate(pubDate) })}</time>
      {updatedDate && <time datetime={updatedDate.toISOString()}>{t('article.updatedOn', { date: formatDate(updatedDate) })}</time>}
      {readingMinutes && <span>{t('article.readingTime', { minutes: readingMinutes })}</span>}
      {seriesSlug && seriesItem && (hasPage('series')
        ? <a href={seriesPath(seriesSlug)}>{seriesItem.title}</a>
        : <span>{seriesItem.title}</span>)}
    </div>
    {tags.length > 0 && (
      <div class="tags">
        {tags.map((tag) => <span>{tag}</span>)}
      </div>
    )}
  </div>
</header>
