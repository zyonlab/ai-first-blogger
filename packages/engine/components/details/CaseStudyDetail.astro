---
import Breadcrumbs from '@components/Breadcrumbs.astro';
import NewsletterCTA from '@components/NewsletterCTA.astro';
import { categoryLabel } from '@config/taxonomy';
import type { AnyComponent } from '@lib/renderers';
import { listPath } from '@content-types/index';
import type { DetailProps } from './detail-props';

const { entry, type, Content, canonical } = Astro.props as DetailProps;
const Body = Content as AnyComponent;
const data = entry.data as {
  title: string;
  description: string;
  category: string;
  tags: string[];
};
---

<article class="article-shell">
  <Breadcrumbs items={[{ href: listPath(type), label: type.listTitle }, { href: canonical, label: data.title }]} />
  <header class="article-header">
    <p class="eyebrow">{type.label} · {categoryLabel(data.category)}</p>
    <h1>{data.title}</h1>
    <p>{data.description}</p>
    <div class="tags">
      {data.tags.map((tag) => <span>{tag}</span>)}
    </div>
  </header>
  <div class="prose">
    <Body />
  </div>
  <NewsletterCTA />
</article>
