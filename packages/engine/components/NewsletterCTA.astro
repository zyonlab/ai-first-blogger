---
/**
 * The end-of-article call to action.
 *
 * Both destinations are pages a site can decline in `engine({ pages })`, so
 * both are conditional and the panel disappears when neither exists. A CTA
 * with no action left in it is not a smaller CTA — it is a paragraph asking
 * the reader to do something and no way to do it.
 */
import { hasPage, localeOfPath, pagePath } from '@config/routes';
import { messages } from '@i18n/index';

const locale = localeOfPath(Astro.url.pathname);
const t = messages(locale);

const primary = hasPage('work-with-me');
const secondary = hasPage('newsletter');
---

{(primary || secondary) && (
<section class="cta-panel">
  <p>{t('cta.text')}</p>
  <div class="actions">
    {primary && <a class="button primary" href={pagePath('work-with-me', locale)}>{t('cta.primary')}</a>}
    {secondary && <a class="button" href={pagePath('newsletter', locale)}>{t('cta.secondary')}</a>}
  </div>
</section>
)}
