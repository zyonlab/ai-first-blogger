---
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import JsonLd from '@components/JsonLd.astro';
import SEO from '@components/SEO.astro';
import { localeOfPath } from '@config/routes';
import { siteFor } from '@config/site';
import { messages } from '@i18n/index';
import type { Alternate } from '@lib/alternates';
import { personSchema, websiteSchema } from '@lib/schema';
import { themeNames, themes, themesDir } from 'virtual:aifb/themes';
import '../styles/global.css';

/**
 * The locale of the page being rendered, read from its own URL.
 *
 * Not a prop and not a module-level constant. A prop would have to be threaded
 * through every page and every override, and the one that forgot would render a
 * correct-looking page with the wrong `lang` on it; a module-level constant is
 * shared mutable state across a concurrent static build. The URL is neither —
 * it is already per-render and already correct.
 */
const locale = localeOfPath(Astro.url.pathname);
const site = siteFor(locale);
const t = messages(locale);

/**
 * Theme tokens, handed over by the integration rather than reached for. The
 * engine does not know where the site keeps its themes — `themesDir` in
 * astro.config does, and a package that guesses at the layout of the project
 * installing it breaks the first time either one moves.
 *
 * Switching themes stays a one-line change in site/site.yaml.
 */
const themeUrl = themes[site.theme.name];
if (!themeUrl) {
  throw new Error(
    `site.theme.name is "${site.theme.name}" but ${themesDir}/${site.theme.name}.css does not exist. ` +
      `Available: ${themeNames.join(', ') || '(none)'}`,
  );
}

type Props = {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  tags?: string[];
  /** Social-card overrides. Each falls back outward; see SEO.astro. */
  ogTitle?: string;
  ogDescription?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  twitterImage?: string;
  /** The same page in other languages. See @lib/alternates. */
  alternates?: Alternate[];
};

const {
  title = site.name,
  description = site.description,
  canonical,
  image,
  type = 'website',
  noindex = false,
  jsonLd,
  publishedTime,
  modifiedTime,
  tags,
  ogTitle,
  ogDescription,
  twitterTitle,
  twitterDescription,
  twitterImage,
  alternates,
} = Astro.props;

const defaultJsonLd = [websiteSchema(locale), personSchema(true, locale)];
---

<!doctype html>
<html lang={locale} data-theme={site.theme.defaultMode} data-theme-key={site.themeStorageKey}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="theme-color"
      content={site.theme.defaultMode === 'light' ? site.theme.colorLight : site.theme.colorDark}
      data-theme-color
      data-dark={site.theme.colorDark}
      data-light={site.theme.colorLight}
    />
    <link rel="stylesheet" href={themeUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      type={type}
      noindex={noindex}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
      ogTitle={ogTitle}
      ogDescription={ogDescription}
      twitterTitle={twitterTitle}
      twitterDescription={twitterDescription}
      twitterImage={twitterImage}
      alternates={alternates}
    />
    <JsonLd data={jsonLd ?? defaultJsonLd} />
    <script is:inline>
      const root = document.documentElement;
      const theme = localStorage.getItem(root.dataset.themeKey ?? 'theme');
      const resolvedTheme = theme === 'light' || theme === 'dark' ? theme : root.dataset.theme;
      root.dataset.theme = resolvedTheme;
      const meta = document.querySelector('[data-theme-color]');
      const colour = meta?.getAttribute(resolvedTheme === 'light' ? 'data-light' : 'data-dark');
      if (colour) meta?.setAttribute('content', colour);
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t('nav.skipToContent')}</a>
    <div class="site-shell">
      <Header />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
