---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';

type Props = {
  title: string;
  description: string;
  eyebrow?: string;
  canonical?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * Visible breadcrumb trail. Pass this whenever the page emits BreadcrumbList
   * JSON-LD — structured data must describe what is actually rendered (C-10).
   */
  breadcrumbs?: { href: string; label: string }[];
};

const { title, description, eyebrow, canonical, jsonLd, breadcrumbs } = Astro.props;
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  {breadcrumbs && breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} />}
  <section class="page-hero narrow">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    <p>{description}</p>
  </section>
  <slot />
</BaseLayout>
