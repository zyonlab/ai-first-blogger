# Environment contract. Three categories, and they are not interchangeable.
#
# 1. BUILD-TIME, PUBLIC — baked into the output, safe to commit.
#    Overrides `url` in site/site.yaml. CI sets it; set it locally only to
#    preview what canonical URLs will look like.
PUBLIC_SITE_URL=https://your-domain.example

#    Which kind of deploy this build is for. `preview` marks every page
#    noindex, ships no sitemap, and makes robots.txt disallow everything, so a
#    branch preview cannot compete with production for the same queries.
#    Anything else (including unset) builds for production.
DEPLOY_CONTEXT=production

# 2. DEPLOY-TIME, SECRET — never in this file, never in the repository.
#    Set them as GitHub repository secrets:
#      CLOUDFLARE_API_TOKEN     Cloudflare → My Profile → API Tokens
#                               (template: "Edit Cloudflare Workers")
#      CLOUDFLARE_ACCOUNT_ID    Cloudflare dashboard URL, or the sidebar
#
# 3. CI-PROVIDED — nothing to configure.
#      GITHUB_TOKEN             injected by Actions
#
# Non-secret deploy settings live in .github/workflows/cloudflare-pages.yml:
#   CLOUDFLARE_PAGES_PROJECT_NAME, PUBLIC_SITE_URL
# Both ship as REPLACE_ME and the planning preflight refuses to run until set.
