{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components/*": [
        "packages/engine/components/*"
      ],
      "@config/*": [
        "packages/engine/config/*"
      ],
      "@content-types/*": [
        "packages/engine/content-types/*"
      ],
      "@i18n/*": [
        "packages/engine/i18n/*"
      ],
      "@layouts/*": [
        "packages/engine/layouts/*"
      ],
      "@lib/*": [
        "packages/engine/lib/*"
      ]
    }
  }
}
