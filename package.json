{
  "name": "aifb-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "context": "tsx packages/cli/src/context.ts",
    "validate": "tsx packages/cli/src/validate/index.ts",
    "validate:self-test": "tsx packages/cli/src/validate/self-test.ts",
    "test:scenarios": "tsx packages/cli/src/test-scenarios.ts",
    "metrics": "tsx packages/cli/src/metrics.ts",
    "analyze": "tsx packages/cli/src/analyze-content.ts",
    "audit:seo": "lhci autorun",
    "og:default": "tsx packages/cli/src/generate-og-default.ts",
    "migrate:ghost": "tsx packages/cli/src/convert-ghost-to-mdx.ts",
    "build:packages": "pnpm -r --filter aifb-cli --filter create-aifb build",
    "release:check": "node tools/check-release.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "aifb-cli": "workspace:*",
    "aifb-engine": "workspace:*",
    "astro": "^7.0.6",
    "mermaid": "^11.16.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@lhci/cli": "^0.15.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.11"
  },
  "description": "The site: intent in site/, articles in content/. The framework lives in packages/."
}
