{
  "name": "ai-first-blogger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm content:validate && pnpm assets:validate && astro build && pnpm page-experience:validate -- --dist dist && pnpm rich-results:inspect -- --dist dist && node scripts/validate-build.mjs",
    "build:astro": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test:phase-zero": "node scripts/test-phase-zero.mjs",
    "test:phase-one": "tsx scripts/test-phase-one.ts",
    "test:phase-two": "tsx scripts/test-phase-two.ts",
    "test:phase-three": "pnpm test:discovery && pnpm test:images && pnpm test:redirects && pnpm test:freshness",
    "test:phase-four": "tsx scripts/test-search-evidence.ts && tsx scripts/test-page-experience.ts && tsx scripts/test-rich-results.ts",
    "test:phase-five": "pnpm test:site-init && pnpm test:importers && pnpm test:mcp-write",
    "test:importers": "tsx scripts/test-importers.ts",
    "test:mcp-write": "tsx mcp/test-write-guard.ts && tsx mcp/test-protocol.ts",
    "test:discovery": "tsx scripts/test-discovery.ts",
    "test:freshness": "tsx scripts/test-content-freshness.ts",
    "test:images": "tsx scripts/test-images.ts",
    "test:redirects": "tsx scripts/test-redirects.ts",
    "images:generate": "tsx scripts/images.ts generate",
    "images:validate": "tsx scripts/images.ts validate",
    "redirects:generate": "tsx scripts/redirects.ts generate",
    "redirects:validate": "tsx scripts/redirects.ts validate",
    "assets:validate": "pnpm images:validate && pnpm redirects:validate",
    "test:site-init": "tsx scripts/test-site-init.ts",
    "site:init": "tsx scripts/site-init.ts",
    "content:import": "tsx scripts/import-content.ts",
    "roadmap:validate": "tsx scripts/validate-roadmap.ts",
    "search:evidence": "tsx scripts/search-evidence.ts",
    "page-experience:validate": "tsx scripts/page-experience.ts validate",
    "page-experience:budgets": "tsx scripts/page-experience.ts lighthouse-budgets",
    "rich-results:inspect": "tsx scripts/rich-results-release.ts inspect",
    "rich-results:validate-record": "tsx scripts/rich-results-release.ts validate-record",
    "content:new": "tsx scripts/content-workflow.ts new",
    "content:validate": "tsx scripts/content-workflow.ts validate",
    "content:audit": "tsx scripts/content-workflow.ts audit",
    "content:transition": "tsx scripts/content-workflow.ts transition",
    "content:editorial-audit": "tsx scripts/editorial-audit.ts",
    "content:freshness": "tsx scripts/content-freshness.ts",
    "content:scheduled": "tsx scripts/scheduled-content.ts",
    "prompt:regression": "tsx scripts/prompt-regression.ts",
    "prompt:record-host": "tsx scripts/record-host-result.ts",
    "mcp:server": "tsx mcp/server.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.0.6",
    "gray-matter": "4.0.3",
    "mermaid": "11.16.0",
    "turndown": "7.2.4",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@modelcontextprotocol/sdk": "1.29.0",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  }
}
